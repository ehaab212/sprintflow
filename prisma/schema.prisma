generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum StoryStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum StoryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BugStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  FIXED
  CLOSED
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String?
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects   Project[]       @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  assignedBugs    Bug[]           @relation("BugAssignee")
  assignedStories Story[]         @relation("StoryAssignee")
  comments        Comment[]       @relation("CommentAuthor")
  activities      Activity[]      @relation("UserActivities")
  notifications   Notification[]  @relation("UserNotification")
  attachments     Attachment[]    @relation("AttachmentUploader")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  sprints     Sprint[]
  stories     Story[]
  tasks       Task[]
  bugs        Bug[]
  comments    Comment[]
  activities  Activity[]
  attachments Attachment[]

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stories Story[]
  tasks   Task[]
  bugs    Bug[]

  @@index([projectId])
}

model Story {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  sprintId    String?       @db.Uuid
  title       String
  description String?
  priority    StoryPriority @default(MEDIUM)
  points      Int?
  status      StoryStatus   @default(TODO)
  assigneeId  String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee User?   @relation("StoryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  storyId     String?      @db.Uuid
  sprintId    String?      @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  points      Int?
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  story    Story?  @relation(fields: [storyId], references: [id], onDelete: SetNull)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]

  @@index([projectId])
  @@index([storyId])
  @@index([sprintId])
  @@index([assigneeId])
}

model Bug {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @db.Uuid
  sprintId    String?     @db.Uuid
  title       String
  description String?
  severity    BugSeverity @default(MEDIUM)
  status      BugStatus   @default(NEW)
  environment String?
  assigneeId  String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee User?   @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  taskId    String?  @db.Uuid
  storyId   String?  @db.Uuid
  bugId     String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  bug     Bug?    @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@index([taskId])
  @@index([storyId])
  @@index([bugId])
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  targetId   String   @db.Uuid
  targetType String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserActivities", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  message   String
  readAt    DateTime?
  link      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation("UserNotification", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  uploaderId String?  @db.Uuid
  taskId     String?  @db.Uuid
  storyId    String?  @db.Uuid
  bugId      String?  @db.Uuid
  fileName   String
  url        String
  size       Int?
  mimeType   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User?   @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  task     Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  story    Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  bug      Bug?    @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploaderId])
  @@index([taskId])
  @@index([storyId])
  @@index([bugId])
}
